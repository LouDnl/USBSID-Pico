;
; Description:
; Repeatedly get one word of data from the TX FIFO, stalling when the FIFO is
; empty. Write the least significant bit to the OUT pin group.
;


; SID Clock ~ IN ON PIN 17
; SID Clock ~ PIO0 SM0

.define PUBLIC CLK2 17
.program clock_link

.side_set 1

.wrap_target ; Free 0 cycle unconditional jump
wait 1 gpio CLK2  side 1 ; Wait for input high, drive pin high same cycle <--- 250 ns execution time with 4MHz clock
wait 0 gpio CLK2  side 0 ; Wait for input low,  drive pin low same cycle <--- 250 ns ;total 500 ns period
.wrap


%c-sdk{
  /* Program to initialise the PIO */
  static inline void clock_link_program_init(PIO pio, uint sm, uint offset, uint pin, float clk_div) {
    pio_sm_config c = clock_link_program_get_default_config(offset); /* Get default configurations for the PIO state machine */
    sm_config_set_sideset_pins(&c, pin);                        /* Use sideset to set the clock pin */
    sm_config_set_clkdiv(&c, clk_div);                          /* Set the state machine clock divider */
    pio_gpio_init(pio, pin);                                    /* Setup the function select for a GPIO pin to use output from the given PIO instance */
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_init(pio, sm, offset, &c);                           /* Resets the state machine to a consistent state, and configures it */
    pio_sm_set_enabled(pio, sm, true);                          /* Enable or disable a PIO state machine */
  }

  /**
   * @brief Unused and not implemented, the clock should never deinit.
   *
   */
  static inline void clock_link_program_deinit(PIO pio, uint sm, uint offset, const struct pio_program clock_link_program) {
    pio_sm_set_enabled(pio, sm, false);                    /* Disable the PIO state machine */
    pio_remove_program(pio, &clock_link_program, offset);  /* Remove the clock program at provided offset from the PIO state machine */
    pio_sm_unclaim(pio, sm);                               /* Free the claimed PIO state machine */
  }
%}
