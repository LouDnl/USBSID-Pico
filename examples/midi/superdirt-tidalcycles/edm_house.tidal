-- USBSID-Pico SuperDirt demo 2/6: "Basement Loop" - Am-F-C-G house/EDM groove
-- 3 SIDs, 3 channels, 3 factory patches (0-15). Same channel-mapping and
-- boot-volume notes as pop_classical.tidal - see that file.
--
-- Ported 1:1 from ../strudel/edm_house.strudel.js - see that file for the
-- full musical/firmware commentary.
--
-- Patch choices (repo/src/midi_patch.c factory bank):
--   14 Wide bass      - pulse ~65% duty, punchy, no filter to fight the stabs
--   6  Filtered lead   - sawtooth through a resonant low-pass, classic stab tone
--   2  Pulse lead      - ~50% duty pulse, crisp and cuts through for the arp

once $ ccn 123 # ccv 127 # s "usbsidpico" # midichan 1  -- All Notes Off (SID + FMOpl), normalized 1 -> 127

do
  once $ ccn 88 # ccv 0 # s "usbsidpico" # midichan 1  -- Reset channel 1 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0 # s "usbsidpico" # midichan 2  -- Reset channel 2 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0 # s "usbsidpico" # midichan 3  -- Reset channel 3 to SID (CC_FMEN off)
  -- CC_ARPE/CC_UNIS are sticky too (same as CC_FMEN) - a previous demo
  -- (e.g. big_top_showcase leaves channel 3's arp ON) would otherwise
  -- hijack this song's note input on that channel.
  once $ ccn 12 # ccv 0 # s "usbsidpico" # midichan 1  -- arp off ch1
  once $ ccn 12 # ccv 0 # s "usbsidpico" # midichan 2  -- arp off ch2
  once $ ccn 12 # ccv 0 # s "usbsidpico" # midichan 3  -- arp off ch3
  once $ ccn 41 # ccv 0 # s "usbsidpico" # midichan 1  -- unison off ch1
  once $ ccn 41 # ccv 0 # s "usbsidpico" # midichan 2  -- unison off ch2
  once $ ccn 41 # ccv 0 # s "usbsidpico" # midichan 3  -- unison off ch3
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 1 # progNum 14  -- SID1: Wide bass
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 2 # progNum 6   -- SID2: Filtered lead (stabs)
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 3 # progNum 2   -- SID3: Pulse lead (arp)

-- setcps 0.9 -- uncomment and tune to taste - faster suits this one

-- Bass: pumping eighth-notes, root follows the progression one bar at a time
d1 $ note "<[a2*8] [f2*8] [c2*8] [g2*8]>"
   # s "usbsidpico" # midichan 1

-- Stabs: off-beat chord hits, classic house "and-of-2/and-of-4" feel.
-- Root-position triads.
d2 $ struct "~ t ~ t ~ t ~ t"
  $ n "<a'min f'maj c'maj g'maj>"
  # s "usbsidpico" # midichan 2

-- Lead: rolling 16th-note arpeggio through each chord's scale. Original:
-- n("<[0 2 4 7]*4>").scale("<A3:minor F3:major C4:major G3:major>") - degrees
-- 0/2/4/7 in each diatonic scale are that chord's root/3rd/5th/octave, resolved
-- by hand below rather than relying on unverified Tidal `scale` mini-notation
-- parity with Strudel's.
d3 $ note "<[a3 c4 e4 a4]*4 [f3 a3 c4 f4]*4 [c4 e4 g4 c5]*4 [g3 b3 d4 g4]*4>"
   # legato 1
   # s "usbsidpico" # midichan 3

-- To stop: hush
