-- USBSID-Pico SuperDirt demo 3/6: "Basement Loop II" - Dm-Bb-F-C house/EDM groove
-- 4 parts: 3 real SIDs (bass/stabs/arp) + 1 FMOpl chip (lead hook).
--
-- Ported 1:1 from ../strudel/edm_house_fmopl.strudel.js - see that file for
-- the full musical/firmware commentary.
--
-- Channel map for THIS user's board (2xSID physical config: socket 1 hosts
-- a clone presenting as 2x8580, socket 2 hosts a clone presenting as
-- 1x8580 + 1xFMOpl - 3 real SID slots + 1 FMOpl slot total, cfg.numsids=4):
-- channels 1/2/3 = SID1/2/3 one-SID-each (this board's custom config, not
-- firmware stock default), channel 4 = the FMOpl slot. If your own board's
-- channel mapping differs, adjust the midichan values below.
--
-- FMOpl needs one extra step SID channels don't: CC_FMEN (CC 88) must be
-- sent on channel 4 BEFORE Program Change or notes reach the OPL chip at
-- all - a channel targets a SID by default, targeting FMOpl is opt-in per
-- channel (repo/src/midi_fmopl.h). Unlike SID's boot-silent MODVOL, FMOpl
-- channels default to volume 127 already (midi_fmopl_init()), so no
-- mandatory volume-first step there - CC7 below is sent anyway for parity.

once $ ccn 123 # ccv 127 # s "usbsidpico" # midichan 1  -- All Notes Off (SID + FMOpl), normalized 1 -> 127

-- CC_FMEN is sticky per-channel firmware state - it doesn't reset itself
-- between songs/sessions, so a channel left targeting FMOpl by earlier
-- testing (or an earlier run of this song, on the SID channels) would
-- silently break this one. Explicitly reset channels 1/2/3 to SID and
-- channel 4 to FMOpl every time, don't assume the board's current state.

do
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 1  -- Reset channel 1 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 2  -- Reset channel 2 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 3  -- Reset channel 3 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 127 # s "usbsidpico" # midichan 4  -- Enable FMOpl targeting on channel 4 (CC_FMEN), normalized 1 -> 127
  -- CC_ARPE/CC_UNIS are sticky too (same as CC_FMEN) - a previous demo
  -- (e.g. big_top_showcase leaves channel 3's arp ON) would otherwise
  -- hijack this song's note input on that channel.
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 1  -- arp off ch1
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 2  -- arp off ch2
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 3  -- arp off ch3
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 1  -- unison off ch1
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 2  -- unison off ch2
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 3  -- unison off ch3
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 1 # progNum 14  -- SID1: Wide bass
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 2 # progNum 6   -- SID2: Filtered lead (stabs)
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 3 # progNum 2   -- SID3: Pulse lead (arp)
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 4 # progNum 4   -- FMOpl: Bell (hook)

setcps 0.9 -- uncomment and tune to taste

-- Bass: pumping eighth-notes, root follows the progression one bar at a time
d1 $ note "<[d2*8] [bf1*8] [f2*8] [c2*8]>"
  # s "usbsidpico" # midichan 1

-- Stabs: off-beat chord hits, classic house "and-of-2/and-of-4" feel.
-- Root-position triads. Bb -> af/bf spelling: Tidal accidentals are s
-- (sharp) / f (flat), so Bb = "bf".
d2 $ struct "~ t ~ t ~ t ~ t"
  $ arpeggiate $ n "<d'min bf'maj f'maj c'maj>"
  # s "usbsidpico"
  # midichan 2

-- Arp: rolling 16th-note arpeggio through each chord's scale. Original:
-- n("<[0 2 4 7]*4>").scale("<D3:minor Bb2:major F3:major C3:major>") - degrees
-- 0/2/4/7 resolved by hand to that chord's root/3rd/5th/octave (Tidal's
-- `scale` mini-notation parity with Strudel's wasn't verified, so this
-- wasn't ported as-is).
d3 $ note "<[d3 f3 a3 d4]*4 [bf2 d3 f3 bf3]*4 [f3 a3 c4 f4]*4 [c3 e3 g3 c4]*4>"
  # legato 1
  # s "usbsidpico" # midichan 3

-- FMOpl hook: the instantly-recognisable top line, syncopated, sitting above
-- everything else - this is the part that shows off the OPL chip's own
-- character rather than doubling what a SID could already do.
-- (.transpose(0) in the original was a no-op - dropped.)
d4 $ note "<[d5 f5 a5 ~ d5 c5 a4 ~] [bf4 d5 f5 ~ bf4 a4 f4 ~] [f4 a4 c5 ~ f4 e4 c4 ~] [c4 e4 g4 ~ c4 bf3 g3 ~]>"
  # s "usbsidpico" # midichan 4

-- To stop: hush
