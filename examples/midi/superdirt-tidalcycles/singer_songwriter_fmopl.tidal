-- USBSID-Pico SuperDirt demo 4/6: "Porch Light" - G-D-Em-C singer-songwriter ballad
-- 4 parts: 3 real SIDs (bass/pad/fingerpicked arpeggio) + 1 FMOpl chip
-- (electric piano melody). Same channel map and CC_FMEN setup notes as
-- edm_house_fmopl.tidal - see that file for the full explanation.
--
-- Ported 1:1 from ../strudel/singer_songwriter_fmopl.strudel.js - see that
-- file for the full musical/firmware commentary.
--
-- Slower, gentler than the two EDM/house demos: mostly quarter/eighth notes
-- rather than 16th-note runs, a sustained pad instead of stabs, and a
-- fingerpicked-style arpeggio instead of a pumping bassline groove -
-- FMOpl's Electric Piano instrument carries the melody, which is exactly
-- the kind of warm, slightly-imperfect timbre 2-op FM does well and a
-- plain SID waveform can't really reach.

once $ ccn 123 # ccv 127 # s "usbsidpico" # midichan 1  -- All Notes Off (SID + FMOpl), normalized 1 -> 127

do
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 1  -- Reset channel 1 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 2  -- Reset channel 2 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 0   # s "usbsidpico" # midichan 3  -- Reset channel 3 to SID (CC_FMEN off)
  once $ ccn 88 # ccv 127 # s "usbsidpico" # midichan 4  -- Enable FMOpl targeting on channel 4 (CC_FMEN), normalized 1 -> 127
  -- CC_ARPE/CC_UNIS are sticky too (same as CC_FMEN) - a previous demo
  -- (e.g. big_top_showcase leaves channel 3's arp ON) would otherwise
  -- hijack this song's note input on that channel.
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 1  -- arp off ch1
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 2  -- arp off ch2
  once $ ccn 12 # ccv 0   # s "usbsidpico" # midichan 3  -- arp off ch3
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 1  -- unison off ch1
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 2  -- unison off ch2
  once $ ccn 41 # ccv 0   # s "usbsidpico" # midichan 3  -- unison off ch3
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 1 # progNum 3  -- SID1: Bass
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 2 # progNum 7  -- SID2: Slow pad
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 3 # progNum 4  -- SID3: Pluck (fingerpicked)
  once $ ccn 7 # ccv 127 # s "usbsidpico" # midichan 4 # progNum 1  -- FMOpl: Electric piano

-- setcps 0.55 -- uncomment and tune to taste - unhurried, ballad pace

-- Bass: simple root notes under each chord, mostly held rather than pumping
d1 $ note "<g2(1,2) d2(1,2) e2(1,2) c2(1,2)>"
  # s "usbsidpico" # midichan 1

-- Pad: sustained triads under everything else, the warm backing bed.
-- Root-position triads.
d2 $ n "<g'maj d'maj e'min c'maj>"
  # s "usbsidpico" # midichan 2

-- Fingerpicked-style arpeggio: gentler than the house demo's 16th-note
-- runs - eighth notes, broken-chord shape rather than a straight run up
d3 $ note "<[g3 b3 d4 g4 d4 b3] [d3 fs3 a3 d4 a3 fs3] [e3 g3 b3 e4 b3 g3] [c3 e3 g3 c4 g3 e3]>"
  # legato 1
  # s "usbsidpico" # midichan 3

-- FMOpl electric piano: the melody, phrased simply and mostly stepwise -
-- this is the line a voice would sit next to in a real song, so it stays
-- out of the way rhythmically rather than competing with the arpeggio.
-- (.transpose(0) in the original was a no-op - dropped.)
d4 $ note "<[d5 ~ b4 ~ a4 ~ g4 ~] [a4 ~ fs4 ~ d4 ~ ~ ~] [b4 ~ g4 ~ e4 ~ ~ ~] [c5 ~ g4 ~ e4 ~ d4 ~]>"
  # s "usbsidpico" # midichan 4

-- To stop: hush
