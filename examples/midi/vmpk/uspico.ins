.Controller Names


[USBSID-Pico Midi Control]

;Core note/pitch
28=Note frequency for manual input
1=Pulse Width Modulation (Modulation wheel)

;Waveform select
20=Noise waveform
21=Pulse waveform
22=Sawtooth waveform
23=Triangle waveform

;Voice control bits
24=Test bit
25=Ring modulator bit
26=Sync bit
27=Gate bit

;Envelope (ADSR)
17=Attack
18=Decay
19=Sustain
29=Release (moved off 0x14, collided with CC_NOIS)

;Default values=Chip related
32=Filter Frequency Cutoff
33=Filter resonance
34=Filter voice 1
35=Filter voice 2
36=Filter voice 3
37=Filter external
48=Voice 3 disconnect
49=High pass
50=Band pass
51=Low pass
7=Channel Volume

;Default values=Phase 4 modulation and timing
0=LFO waveform
2=LFO rate
3=LFO depth
4=LFO destination
13=LFO 2 waveform
14=LFO 2 rate
15=LFO 2 depth
16=LFO 2 destination
5=Portamento time
6=Arpeggiator mode
10=Arpeggiator rate
11=Arpeggiator octave range
12=Arpeggiator enable
30=Arpeggiator table select

;Default CC values=SID / Voice selection
104=Select SID 1
105=Select SID 2
106=Select SID 3
107=Select SID 4
108=Select Voice 1
109=Select Voice 2
110=Select Voice 3

;Default CC values=custom commands
111=Turn on polyfonic for current SID
119=Gate auto enabled on noteon note off
8=Enable copy voice mode
9=Enable copy SID mode (moved off 0x18, collided with CC_TEST)
40=Link/Unlink voice
56=Link/Unlink SID
72=Velocity Mode

; other per-voice-shape override CC
41=Unison mode on/off
42=Unison detune spread
88=Target this channel at the FMOpl chip instead of a SID

;Midi related=Fixed values
120=All Sound Off
121=Reset All Controllers
123=All Notes Off
126=Mono Mode On=Poly off & all notes off
127=Poly Mode On=Mono off & all notes off

;Cynthcart related _FIXED_ CC values
85=Enable Cynthcart
86=Disable Cynthcart
87=Reset Cynthcart

;Unused values=Midi related
255=Bank Select MSB
255=Bank Select LSB
255=Modulation wheel
255=Modulation wheel LSB

[USBSID Cynthcart Control]
0=Filter Resonance
1=Filter Cutoff (wheel)
2=Select Voice Mode
3=Select Modulation Mode
4=Attack
5=Release
6=Pulse Width
7=Master Volume
8=Tremolo Depth
9=Tremolo Speed
13=Osc Waveform (all voices)
14=Osc Waveform (voice 2 only)
15=Osc Waveform (voice 3 only)
85=Start Cynthcart
86=Stop Cynthcart
87=Reset Cynthcart

