# Ignore everything by default
*

# extensions in specific repo directories
!src/**/*.c
!src/**/*.cpp
!src/**/*.h
!src/**/*.ld
!src/**/*.pio

# extensions anywhere in the repo
!*.adoc
!*.ini
!*.jpg
!*.mp3
!*.pdf
!*.png
!*.svg
!*.rules
!*.xcf
!*.yml
!*.zip

# specific files
!.gitignore
!.gitattributes
!.gitmodules
!LICENSE
!README.md
!SHOWCASE.md
!CHANGELOG.md
!CMakeLists.txt

# tool files
!libusb-1.0.dll
!libwinpthread-1.dll

# repo directories
!.github
!.github/**
!.gitlab
!.gitlab/**

# firmware source directories
!src
!src/pio
!lib

# non firmware related directories (and if applicable their contents)
!cases
!cases/**
!doc
!doc/images
!doc/images/configtool
!doc/images/firmware
!doc/images/software
!doc/images/v1.0
!doc/images/v1.3
!doc/images/v1.5
!doc/images/vol
!hardware
!hardware/**
!images
!images/tees
!media
!examples
!examples/cloje64
!examples/config-tool
!examples/config-tool/ini-examples
!examples/config-tool/inih
!examples/config-tool-web
!examples/config-tool-web/images
!examples/config-tool-web/lib
!examples/config-tool-web/SID
!examples/config-tool-web/usplayer
!examples/config-tool-web/usplayer/**
!examples/config-tool-web/websid
!examples/config-tool-web_old
!examples/send_sid
!examples/hardsid-sidblaster
!examples/udev-rules
!examples/midi
!examples/midi/strudel
!examples/midi/superdirt-tidalcycles
!examples/midi/vmpk
!examples/Cynthcart-Ninja_VST
!resources

# recursive directory contents
!examples/cloje64/**
!examples/config-tool/inih/**
!examples/config-tool-web_old/**
!examples/hardsid-sidblaster/**
!examples/udev-rules/**
!examples/Cynthcart-Ninja_VST/**

